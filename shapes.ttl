@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix esop:   <https://goalc.net/ontology/esop#> .
@prefix irc:    <https://goalc.net/ontology/irc#> .
@prefix erisa:  <https://goalc.net/ontology/erisa#> .

# Hand-written rules for the Corsair Components ESOP graph.
# These are independent tests: they state what the graph SHOULD be,
# not what it currently happens to be.

esop:PlanShape a sh:NodeShape ;
    sh:targetClass esop:EmployeeStockOwnershipPlan ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path esop:hasPart ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class esop:PlanProvision ] ;
    sh:property [ sh:path irc:qualifyingSection ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:class esop:IRCSection ] .

esop:ProvenanceShape a sh:NodeShape ;
    sh:targetClass esop:PlanProvision , esop:DefinedTerm , esop:IRCSection , esop:ERISASection ;
    sh:property [ sh:path schema:name ; sh:name "name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:version ; sh:name "version" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:lastReviewed ; sh:name "last reviewed date" ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ] ;
    sh:property [ sh:path schema:confidence ; sh:name "confidence" ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:minInclusive 0 ; sh:maxInclusive 1 ] .

esop:ProvisionShape a sh:NodeShape ;
    sh:targetClass esop:PlanProvision ;
    sh:property [ sh:path esop:sectionNumber ; sh:name "section number" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path irc:authority ; sh:name "IRC authority link" ; sh:nodeKind sh:IRI ; sh:class esop:IRCSection ] ;
    sh:property [ sh:path erisa:authority ; sh:name "ERISA authority link" ; sh:nodeKind sh:IRI ; sh:class esop:ERISASection ] ;
    sh:property [ sh:path esop:definesTerms ; sh:name "defined-term link" ; sh:nodeKind sh:IRI ; sh:class esop:DefinedTerm ] .

esop:TermShape a sh:NodeShape ;
    sh:targetClass esop:DefinedTerm ;
    sh:property [ sh:path esop:definition ; sh:name "definition" ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:string ; sh:minLength 10 ] .

esop:IRCShape a sh:NodeShape ;
    sh:targetClass esop:IRCSection ;
    sh:property [ sh:path esop:description ; sh:name "description" ; sh:minCount 1 ; sh:datatype xsd:string ] .

esop:ERISAShape a sh:NodeShape ;
    sh:targetClass esop:ERISASection ;
    sh:property [ sh:path esop:description ; sh:name "description" ; sh:minCount 1 ; sh:datatype xsd:string ] .

esop:CrossReferenceShape a sh:NodeShape ;
    sh:targetClass esop:CrossReferenceMapping ;
    sh:property [ sh:path schema:provision ; sh:name "plan provision link" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:ircAuthority ; sh:name "IRC link" ; sh:nodeKind sh:IRI ; sh:class esop:IRCSection ] .

    {
      "@id": "esop:Section_11",
      "@type": "esop:PlanProvision",
      "esop:sectionNumber": "11",
      "name": "Allocation of Contributions and Forfeitures",
      "esop:subsections": [
        "11a Allocation Formula",
        "11b Allocation Limitations"
      ],
      "esop:summary": "Allocations made pro-rata by Covered Compensation. Annual Additions cap: lesser of $49,000 (inflation-adjusted) or 100% of Total Compensation. Interest payments on SAL excluded from Annual Additions if ≤1/3 of Contributions go to HCEs.",
      "irc:authority": [
        "irc:401_a_4",
        "irc:415_c",
        "irc:404_a_9"
      ],
      "esop:allocationFormula": {
        "@id": "esop:Rule_AllocationFormula",
        "@type": "esop:AllocationRule",
        "name": "Pro-Rata Compensation Allocation",
        "esop:formula": "Participant Allocation = (Participant Covered Comp / Total Covered Comp of All Participants) × Total Contributions + Forfeitures Released",
        "irc:authority": [
          "irc:401_a_4"
        ],
        "version": "1.0.0",
        "lastReviewed": "2026-05-28",
        "confidence": 0.95
      },
      "esop:annualAdditionsCap": {
        "@id": "esop:Rule_415Cap",
        "@type": "esop:LimitationRule",
        "name": "§415 Annual Additions Limit",
        "esop:limitAmount": 49000,
        "esop:limitNote": "Adjusted for cost-of-living per IRC §415(d); current limit $69,000 for 2024",
        "esop:alternateLimit": "100% of Participant Total Compensation",
        "esop:applicableRule": "Lesser of dollar limit or compensation limit",
        "irc:authority": [
          "irc:415_c"
        ],
        "version": "1.0.0",
        "lastReviewed": "2026-05-28",
        "confidence": 0.95
      },
      "version": "1.0.0",
      "lastReviewed": "2026-05-28",

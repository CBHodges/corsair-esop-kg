    {
      "@id": "esop:Term_QualifiedEmployerSecurities",
      "@type": "esop:DefinedTerm",
      "name": "Qualified Employer Securities",
      "esop:definition": "Employer Securities which are issued by a domestic C corporation that has no securities outstanding that are readily tradable on an established securities market, have been held for at least three (3) years by the seller and were not received by the seller in a distribution from a plan qualified under Section 401(a) or in a transfer pursuant to an option or other right to acquire stock under Section 83, 422, 422A, 423 or 424 of the Code. See Section 6(d) of the Plan.",
      "esop:sourceSection": "Section 2 (Definitions)",
      "isBasedOn": "https://www.sec.gov/Archives/edgar/data/1486183/000119312512186418/d52593dex1020.htm",

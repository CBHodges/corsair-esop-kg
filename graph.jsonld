      "@type": "esop:DefinedTerm",
      "name": "BreakInService",
      "esop:definition": "A Plan Year in which a Participant completes no more than 500 Hours of Service.",
      "version": "1.0.0",
      "lastReviewed": "2026-05-28",
      "confidence": 0.95
    },
    {

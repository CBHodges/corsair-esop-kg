      "esop:subsections": [
        "6a Authorized Investments",
        "6b Investment Duties",
        "6c Plan Loans",
        "6d Nonrecognition of Gain"
      ],
      "esop:summary": "Governs leveraged loan (Securities Acquisition Loan) mechanics and §1042 rollover election for seller nonrecognition of gain.",
      "irc:authority": [
        "irc:4975_d_3",
        "irc:1042"
      ],
      "esop:loanStructure": "Securities Acquisition Loan — leveraged ESOP",
      "esop:1042Rollover": {
        "@id": "esop:Rule_1042Rollover",
        "@type": "esop:TaxRule",
        "name": "§1042 Nonrecognition of Gain",
        "esop:summary": "Seller may elect to defer capital gains tax by reinvesting in Qualified Replacement Property within 12 months. Nonallocation period: 10 years or final loan payment date (later).",
        "esop:nonallocationPeriod": "10 years from sale date OR date of final SAL payment, whichever is later",
        "esop:restrictedPersons": "Seller, seller's family, and persons owning >25% of any class of Company Stock",
        "esop:linealDescendantException": "Up to 5% of purchased shares may be allocated to lineal descendants",
        "irc:authority": [
          "irc:1042"
        ],
        "version": "1.0.0",
        "lastReviewed": "2026-05-28",
        "confidence": 0.95
      },
      "version": "1.0.0",
      "lastReviewed": "2026-05-28",
      "confidence": 0.95
    },
    {
      "@id": "esop:Section_7",
      "@type": "esop:PlanProvision",
      "esop:sectionNumber": "7",
      "name": "Allocations to Accounts",
      "esop:subsections": [
        "7a Individual Accounts",
        "7b Company Stock Account",
        "7c Other Investments Account"
      ],
      "esop:summary": "Governs share release from Suspense Account on loan repayment. Two release methods: General Rule (principal+interest fraction) and Special Rule (principal-only fraction, max 10 years).",
      "esop:shareReleaseMethods": [
        {
          "@id": "esop:Rule_ShareRelease_General",
          "@type": "esop:AllocationRule",
          "name": "General Rule — Share Release",
          "esop:formula": "Shares Released = Suspense Shares × (Principal+Interest Paid / (Principal+Interest Paid + Future Principal+Interest))",
          "esop:trigger": "Each Plan Year for duration of SAL",
          "version": "1.0.0",
          "lastReviewed": "2026-05-28",
          "confidence": 0.95
        },
        {
          "@id": "esop:Rule_ShareRelease_Special",
          "@type": "esop:AllocationRule",
          "name": "Special Rule — Share Release (Principal Only)",
          "esop:formula": "Shares Released = Suspense Shares × (Principal Paid / (Principal Paid + Future Principal))",
          "esop:conditions": [
            "Loan provides level payments ≥10 years",
            "Interest disregarded per standard amortization tables",
            "Total loan duration including renewals ≤10 years"
          ],
          "version": "1.0.0",
          "lastReviewed": "2026-05-28",
          "confidence": 0.95
        }
      ],
      "version": "1.0.0",
      "lastReviewed": "2026-05-28",
      "confidence": 0.95
    },
